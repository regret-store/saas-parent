# 本地开发配置模板。
# 用法：复制为同目录下的 application-local.yml 并填入真实值。
# application-local.yml 已在仓库根目录 .gitignore 中，不会被提交。
# application.yml 里 spring.profiles.active=local，所以该文件会自动生效。
saas:
  internal:
    # 网关下发给下游服务的内部密钥，必须与 saas-tenant-service / saas-ai-service 完全一致
    secret: change-me-gateway-internal-secret
  jwt:
    # HS256 签名密钥，JwtUtils 启动时校验长度 >= 32 字节，不足直接抛异常
    secret: change-me-jwt-signing-secret-at-least-32-bytes-long
    expiration: 86400000
