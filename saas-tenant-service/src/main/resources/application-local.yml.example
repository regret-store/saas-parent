# 本地开发配置模板：复制为同目录下的 application-local.yml 后填真实值。
# application-local.yml 已在 .gitignore 中，不会被提交。
spring:
  datasource:
    dynamic:
      datasource:
        master:
          # 共享库 saas_db（默认 3307）
          password: change-me-master-db-password
        vip:
          # VIP 独立库 vip_db（默认 3308）
          password: change-me-vip-db-password

saas:
  internal:
    # 必须与网关里的值一致，否则下游一律返回 403「拒绝绕过网关直接访问」
    secret: change-me-gateway-internal-secret
  jwt:
    # 与网关同一把密钥，否则网关签发的 Token 在这里验不过
    secret: change-me-jwt-signing-secret-at-least-32-bytes-long
    expiration: 86400000
